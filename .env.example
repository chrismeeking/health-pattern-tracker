# Supabase (required for production)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Integration API key for POST /api/schedule (ChatGPT, Power Automate, etc.)
# Prefer HOMEBOARD_API_KEY; SCHEDULE_API_KEY is also accepted for compatibility.
HOMEBOARD_API_KEY=generate-a-long-random-string
SCHEDULE_API_KEY=

# Admin UI password (/admin)
ADMIN_PASSWORD=choose-a-strong-password

# Used to sign the admin session cookie (defaults to ADMIN_PASSWORD if unset)
AUTH_SECRET=another-long-random-string

# Optional: force in-memory demo data even if Supabase is configured
# HOMEBOARD_DEMO_MODE=true

# Auto-return kiosk display to the current week after inactivity (ms)
NEXT_PUBLIC_INACTIVITY_RESET_MS=300000
